{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": { "api/trial.mjs": { "maxDuration": 15 }, "api/booking.mjs": { "maxDuration": 15 } },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.precisionjiujitsunh.com" }],
      "destination": "https://precisionjiujitsunh.com/:path*",
      "permanent": true
    },
    { "source": "/services", "destination": "/#schedule", "permanent": true },
    { "source": "/services/", "destination": "/#schedule", "permanent": true },
    { "source": "/about", "destination": "/#coaches", "permanent": true },
    { "source": "/about/", "destination": "/#coaches", "permanent": true },
    { "source": "/contact", "destination": "/#trial", "permanent": true },
    { "source": "/contact/", "destination": "/#trial", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {"source":"/privacy-policy","destination":"/privacy","permanent":true},
    {"source":"/cookie-policy","destination":"/cookies","permanent":true},
    {"source":"/terms-of-service","destination":"/terms","permanent":true},
    {"source":"/terms-and-conditions","destination":"/terms","permanent":true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
